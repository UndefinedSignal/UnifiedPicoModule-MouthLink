<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DefineConstants Condition="'$(NativeHost)' == 'true'">$(DefineConstants);NATIVE_HOST</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="UnifiedPicoModule"><HintPath>$(ModuleDll)</HintPath></Reference>
    <ProjectReference Include="$(HostSource)/VRCFaceTracking.Core/VRCFaceTracking.Core.csproj" />
    <ProjectReference Include="$(HostSource)/VRCFaceTracking.ModuleProcess/VRCFaceTracking.ModuleProcess.csproj" Condition="'$(NativeHost)' == 'true'" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.1" />
    <None Update="face-v1-keys.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
